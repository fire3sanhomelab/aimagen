# Cloud API Key (for opencode-go)
OPENCODE_API_KEY=

# Local Endpoints
OLLAMA_URL=http://host.docker.internal:11434
LLM_STUDIO_URL=http://192.168.1.100:1234
COMFYUI_URL=http://host.docker.internal:8188
JANUS_PRO_URL=http://host.docker.internal:8000
