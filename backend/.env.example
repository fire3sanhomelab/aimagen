# AI Image Provider
# Options: opencode-go | ollama | llm-studio | comfyui | janus-pro
AI_IMAGE_PROVIDER=opencode-go

# Cloud
OPENCODE_API_KEY=sk-...

# Local Endpoints (at least one required if using local provider)
OLLAMA_URL=http://localhost:11434
LLM_STUDIO_URL=http://192.168.1.100:1234
COMFYUI_URL=http://localhost:8188
JANUS_PRO_URL=http://localhost:8000

# Server
PORT=3456
NODE_ENV=development
